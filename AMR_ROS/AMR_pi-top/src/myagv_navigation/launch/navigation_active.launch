<?xml version="1.0"?>
<launch>

  <!-- IMU publisher: publishes /imu_data (sensor_msgs/Imu) -->
  <node pkg="amr_imu_pkg"
        type="imu_publisher.py"
        name="imu_publisher"
        output="screen" />

  <!-- Laser: base_footprint -> laser_frame -->
  <node pkg="tf"
        type="static_transform_publisher"
        name="base_footprint_to_laser_frame"
        args="0.065 0.0 0.08 3.14159265 0.0 0.0 base_footprint laser_frame 10" />
        
  <node pkg="tf"
        type="static_transform_publisher"
        name="base_footprint_to_base_link"
        args="0 0 0 0 0 0 base_footprint base_link 50" />

  <!-- IMU: base_link -> external_imu_link -->
  <node pkg="tf"
        type="static_transform_publisher"
        name="base_link_to_external_imu"
        args="0 0 0 0 0 0 base_link external_imu_link 30" />

  <!-- wheel odom + IMU yaw fusion (robot_pose_ekf)
       Subscribes: /odom, /imu_data, /vo
       Publishes: /robot_pose_ekf/odom_combined, TF (odom -> base_footprint)
  -->
  <node pkg="robot_pose_ekf"
        type="robot_pose_ekf"
        name="robot_pose_ekf"
        output="screen">

    <!-- Default input topic names are /odom and /imu_data -->
    <!--
    <remap from="odom"     to="/odom" />
    <remap from="imu_data" to="/imu_data" />
    -->

    <!-- EKF output frame (should match AMCL odom_frame_id) -->
    <param name="output_frame" value="odom" />

    <!-- Robot base footprint frame -->
    <param name="base_footprint_frame" value="base_footprint" />

    <!-- EKF update frequency and sensor timeout -->
    <param name="freq" value="10.0" />
    <param name="sensor_timeout" value="1.0" />

    <!-- Enabled sensors -->
    <param name="odom_used" value="true" />
    <param name="imu_used"  value="true" />
    <param name="vo_used"   value="false" />
    <param name="gps_used"  value="false" />
    
    <param name="odom_data" value="odom" />

    <param name="debug"         value="false" />
    <param name="self_diagnose" value="false" />
  </node>

  <!-- Navigation stack -->

  <arg name="map_file" default="$(find myagv_navigation)/map/map.yaml"/>

  <node name="map_server_for_test"
        pkg="map_server"
        type="map_server"
        args="$(arg map_file)"
        output="screen">
    <param name="frame_id" value="map" />
  </node>

  <arg name="use_map_topic" default="true" />
  <arg name="scan_topic"    default="scan" />

  <node pkg="move_base"
        type="move_base"
        respawn="false"
        name="move_base"
        output="screen">

    <rosparam file="$(find myagv_navigation)/param/costmap_common_params.yaml"
              command="load"
              ns="global_costmap" />
    <rosparam file="$(find myagv_navigation)/param/costmap_common_params.yaml"
              command="load"
              ns="local_costmap" />
    <rosparam file="$(find myagv_navigation)/param/local_costmap_params.yaml"
              command="load" />
    <rosparam file="$(find myagv_navigation)/param/global_costmap_params.yaml"
              command="load" />
    <rosparam file="$(find myagv_navigation)/param/planner.yaml"
              command="load" />

    <param name="base_global_planner" value="global_planner/GlobalPlanner" />
    <param name="planner_frequency"   value="1.0" />
    <param name="planner_patience"    value="2.0" />

    <!-- Only the last base_local_planner value is used.
         Keep one of them active. -->
    <!-- <param name="base_local_planner" value="base_local_planner/TrajectoryPlannerROS" /> -->
    <param name="base_local_planner"  value="dwa_local_planner/DWAPlannerROS" />
    <!-- <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS" /> -->

    <param name="controller_frequency"        value="10.0" />
    <param name="controller_patience"         value="3.0" />
    <param name="clearing_rotation_allowed"   value="true" />

  </node>

  <node pkg="rviz"
        type="rviz"
        name="rviz"
        args="-d $(find myagv_navigation)/rviz/teb.rviz" />

</launch>
